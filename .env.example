# Supabase Configuration Example
# Copy this file to .env and fill in your actual values

# Required: Your Supabase project URL
# Find this in your Supabase dashboard under Settings > API
VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
                  https://zqcjipwiznesnbgbocnu.supabase.co

# Required: Your Supabase anonymous (public) key
# Find this in your Supabase dashboard under Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3AiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYwMjIzOTAyMiwi

# Optional: Service role key (Backend only - DO NOT use in frontend code!)
# Find this in your Supabase dashboard under Settings > API > Project API keys > service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3AiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0Ij

# Optional: Your app's public URL (for redirects, etc.)
# VITE_APP_URL=http://localhost:5173

# Optional: Enable debug logging
# VITE_DEBUG=true