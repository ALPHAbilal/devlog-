# Supabase Configuration Example
# Copy this file to .env and fill in your actual values

# Required: Your Supabase project URL
# Find this in your Supabase dashboard under Settings > API
# For custom domain (after setup): https://api.devlog.design
VITE_SUPABASE_URL=https://zqcjipwiznesnbgbocnu.supabase.co

# Required: Your Supabase anonymous (public) key
# Find this in your Supabase dashboard under Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (Backend only - DO NOT use in frontend code!)
# Find this in your Supabase dashboard under Settings > API > Project API keys > service_role
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration (for OAuth redirects)
# Production: https://devlog.design
# Development: http://localhost:5173
VITE_SITE_URL=https://devlog.design

# Optional: Enable debug logging
# VITE_DEBUG=true